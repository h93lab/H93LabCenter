{
  "name": "h93lab-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178",
    "dev:api": "tsx server/local.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx tests/integration.ts",
    "db:start": "supabase start",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "plugin:build": "node scripts/package-plugin.mjs",
    "db:setup": "node scripts/local-setup.mjs",
    "test:browser": "playwright test",
    "test:acceptance": "tsx tests/acceptance.ts",
    "edge:build": "node scripts/build-edge.mjs",
    "edge:serve": "npm run edge:build && node scripts/serve-edge-local.mjs",
    "edge:serve:cli": "npm run edge:build && supabase functions serve center --env-file .local/edge.env --no-verify-jwt",
    "test:edge": "tsx tests/edge-runtime.ts",
    "cron:local": "node scripts/enable-local-cron.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "5.3.0",
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-query": "5.102.8",
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "lucide-react": "1.42.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router": "8.3.1",
    "remark-gfm": "4.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2"
  },
  "engines": {
    "node": "24.x"
  }
}
