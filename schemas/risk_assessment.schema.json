{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RiskAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "risks",
    "kill_assessments",
    "critical_unknowns"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "severity",
          "description",
          "mitigation",
          "evidence_ids"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "description": {
            "type": "string"
          },
          "mitigation": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "kill_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_key",
          "result",
          "severity",
          "rationale",
          "evidence_ids"
        ],
        "properties": {
          "rule_key": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "severity": {
            "enum": [
              "medium",
              "high",
              "critical"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "critical_unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
