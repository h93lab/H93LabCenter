{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "market_code": {
      "type": "string",
      "minLength": 1
    },
    "factors": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": [
          "value",
          "rationale",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "object",
      "properties": {
        "quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "diversity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "recency": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "agreement": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "specificity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "quality",
        "diversity",
        "recency",
        "agreement",
        "coverage",
        "specificity"
      ],
      "additionalProperties": false
    },
    "critical_unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "hard",
              "warning"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": [
          "rule",
          "result",
          "severity",
          "rationale",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "relation": {
            "type": "string",
            "enum": [
              "direct",
              "indirect",
              "substitute"
            ]
          },
          "strengths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "weaknesses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_ids": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": [
          "name",
          "url",
          "relation",
          "strengths",
          "weaknesses",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "review_clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "theme": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "sentiment": {
            "type": "string",
            "minLength": 1
          },
          "sample_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "member_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": [
          "theme",
          "category",
          "sentiment",
          "sample_size",
          "member_count",
          "summary",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "gap": {
      "type": "string",
      "minLength": 1
    },
    "monetization": {
      "type": "string",
      "minLength": 1
    },
    "distribution": {
      "type": "string",
      "minLength": 1
    },
    "executive_brief": {
      "type": "string",
      "minLength": 1
    },
    "validation_priorities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "market_code",
    "factors",
    "confidence",
    "critical_unknowns",
    "risks",
    "competitors",
    "review_clusters",
    "gap",
    "monetization",
    "distribution",
    "executive_brief",
    "validation_priorities"
  ],
  "additionalProperties": false
}
