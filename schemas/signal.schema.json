{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignalClassifierOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "signals"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signal_type",
          "title",
          "summary",
          "direction",
          "strength_class",
          "confidence",
          "evidence_ids"
        ],
        "properties": {
          "signal_type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "positive",
              "negative",
              "mixed",
              "neutral"
            ]
          },
          "strength_class": {
            "enum": [
              "weak",
              "moderate",
              "strong",
              "extreme",
              "unknown"
            ]
          },
          "quantitative_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "quantitative_unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "market_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "category_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "is_estimate": {
            "type": "boolean",
            "default": false
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    }
  }
}
